  "PoliticalQuestions": {
    "questions": [
      {
        "field": "politics_question_one",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Wichtige Fragen zur Bundespolitik in Deutschland kann ich gut verstehen und einschätzen.",
          "english": "I am able to understand important questions regarding federal politics in Germany."
        }
      },
      {
        "field": "politics_question_two",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Die Abgeordneten des deutschen Bundestages bemühen sich um einen engen Kontakt zur Bevölkerung.",
          "english": "The members of the German parliament strive to keep in close touch with the people."
        }
      },
      {
        "field": "politics_question_three",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Ich traue mir zu, mich an einem Gespräch über politische Fragen zur Bundespolitik aktiv zu beteiligen.",
          "english": "I have the confidence to take an active part in a discussion about issues regarding federal politics."
        }
      },
      {
        "field": "politics_question_four",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Die Abgeordneten des deutschen Bundestages kümmern sich darum, was Leute wie ich denken.",
          "english": "The members of the German parliament care about what people like me think."
        }
      },
      {
        "field": "politics_question_five",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "In schwierigen Situationen kann ich mich auf meine Fähigkeiten verlassen.",
          "english": "In difficult situations, I can trust my capabilities."
        }
      },
      {
        "field": "politics_question_six",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Die meisten Probleme kann ich aus eigener Kraft gut meistern.",
          "english": "I can cope with most problems myself."
        }
      },
      {
        "field": "politics_question_seven",
        "type": "scale",
        "scale_min": 1,
        "scale_max": 5,
        "text": {
          "german": "Auch anstrengende und komplizierte Aufgaben kann ich in der Regel gut lösen.",
          "english": "In general, I can solve challenging and complex tasks."
        }
      }
    ]
  }
